# 复制成 .env 再填值。.env 已在 .gitignore 里，不会被提交。
#
# 说明：
#   - 只有标 ★ 的两项是必须自己申请的（模型服务）
#   - 其余按本地环境改

# ── 应用 ──────────────────────────────────────────────
APP_PORT=8082

# ── MySQL（业务库只读 + ai_ 表可读写）──────────────────
DB_URL=jdbc:mysql://127.0.0.1:3306/jxj?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# ── Redis（登录令牌 + 会话粘性）────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Elasticsearch（知识库检索）─────────────────────────
# 注意：索引名是 jxj_knowledge，别和别的项目的索引混了
ES_URIS=http://127.0.0.1:9200
ES_USERNAME=
ES_PASSWORD=

# ── 主模型（云端，意图分类第 3 层 + 生成答案）★ ────────
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-pro

# ── 本地小模型（意图分类第 2 层 + 答案自评，免费）──────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Embedding + 精排（云端）★ ─────────────────────────
# embedding: text-embedding-v4（1024 维）
# 精排:      gte-rerank-v2
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# ── 初始管理员（只在库里一个 ADMIN 都没有时创建）───────
AI_INIT_ADMIN_USERNAME=admin
AI_INIT_ADMIN_PASSWORD=change-me-before-you-deploy

# ── 令牌有效期 ────────────────────────────────────────
AI_TOKEN_TTL_HOURS=72
